# Discord Application (https://discord.com/developers/applications)
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Neon Postgres (provision via Vercel Marketplace: vercel integration add neon)
DATABASE_URL=

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
# Optional
ELEVENLABS_DEFAULT_VOICE_NAME=Default
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Voice worker (Railway) — Vercel side
VOICE_WORKER_URL=
VOICE_WORKER_SECRET=

# Voice worker (Railway) — set on the worker service only
# VERCEL_URL=https://your-app.vercel.app
